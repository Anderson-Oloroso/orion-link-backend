# ============================================================================
# ORION LINK BACKEND — PLANTILLA DE VARIABLES DE ENTORNO (.env.example)
# Copie este archivo a `.env` y reemplace los secretos antes de desplegar.
# ============================================================================

NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Configuración de Base de Datos MySQL 8.0 InnoDB
# En Docker Compose use DB_HOST=db y DB_PORT=3306
# En desarrollo local contra contenedor MySQL publicado use DB_HOST=127.0.0.1 y DB_PORT=3308
DB_HOST=db
DB_PORT=3306
DB_PUBLISHED_PORT=3308
DB_USER=root
DB_PASSWORD=orion_secret_2026
DB_ROOT_PASSWORD=orion_secret_2026
DB_NAME=orion_link_db
DB_CONNECTION_LIMIT=10

# Seguridad JWT y Cookies HttpOnly
JWT_SECRET=reemplazar_por_secreto_aleatorio_de_al_menos_48_bytes
JWT_EXPIRES_IN=24h
JWT_COOKIE_NAME=orion_access_token
JWT_COOKIE_MAX_AGE_MS=86400000

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173

# Protección contra abuso (Rate Limiting)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX_REQUESTS=30
